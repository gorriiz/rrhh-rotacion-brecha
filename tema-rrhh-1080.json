{
  "name": "RR. HH. · Pizarra y coral (1920x1080)",
  "dataColors": ["#FF7A59", "#3CC6B4", "#F2C14E", "#8FA3BF", "#C77DFF", "#5B8DEF", "#E85D75", "#9BE3D6"],
  "background": "#1F2630",
  "backgroundLight": "#2A3340",
  "backgroundNeutral": "#3A4452",
  "foreground": "#E8ECF1",
  "foregroundNeutralSecondary": "#AEB8C6",
  "foregroundNeutralTertiary": "#7D8898",
  "tableAccent": "#FF7A59",
  "good": "#3CC6B4",
  "neutral": "#F2C14E",
  "bad": "#FF7A59",
  "maximum": "#FF7A59",
  "center": "#5A4A4A",
  "minimum": "#2A3340",
  "textClasses": {
    "callout": { "fontSize": 40, "fontFace": "Segoe UI Light", "color": "#E8ECF1" },
    "title": { "fontSize": 15, "fontFace": "Segoe UI Semibold", "color": "#E8ECF1" },
    "header": { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#E8ECF1" },
    "label": { "fontSize": 12, "fontFace": "Segoe UI", "color": "#AEB8C6" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1F2630" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2E3846" } }, "radius": 6 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 16, "bottom": 16, "left": 18, "right": 18 }],
        "title": [{ "show": true, "fontFamily": "Segoe UI Semibold", "fontSize": 15, "fontColor": { "solid": { "color": "#E8ECF1" } }, "alignment": "left" }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#2E3846" } }, "gridlineStyle": "dotted", "labelColor": { "solid": { "color": "#AEB8C6" } }, "titleColor": { "solid": { "color": "#AEB8C6" } } }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#AEB8C6" } }, "titleColor": { "solid": { "color": "#AEB8C6" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#AEB8C6" } } }],
        "labels": [{ "color": { "solid": { "color": "#E8ECF1" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#161B22" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#161B22" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1F2630" } }, "transparency": 0 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#AEB8C6" } }, "fontSize": 13 }],
        "labels": [{ "color": { "solid": { "color": "#E8ECF1" } }, "fontSize": 40, "fontFamily": "Segoe UI Light" }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1F2630" } }, "transparency": 0 }],
        "header": [{ "fontColor": { "solid": { "color": "#FF7A59" } }, "fontFamily": "Segoe UI Semibold", "textSize": 13 }],
        "items": [{ "fontColor": { "solid": { "color": "#E8ECF1" } }, "background": { "solid": { "color": "#2A3340" } }, "textSize": 13 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#161B22" } }, "backColor": { "solid": { "color": "#FF7A59" } }, "fontFamily": "Segoe UI Semibold" }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E8ECF1" } }, "backColorPrimary": { "solid": { "color": "#1F2630" } }, "fontColorSecondary": { "solid": { "color": "#E8ECF1" } }, "backColorSecondary": { "solid": { "color": "#252D39" } } }],
        "total": [{ "fontColor": { "solid": { "color": "#E8ECF1" } }, "backColor": { "solid": { "color": "#2A3340" } } }],
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#2E3846" } }, "gridVertical": false }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#161B22" } }, "backColor": { "solid": { "color": "#FF7A59" } }, "fontFamily": "Segoe UI Semibold" }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#E8ECF1" } }, "backColor": { "solid": { "color": "#1F2630" } }, "fontFamily": "Segoe UI Semibold" }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E8ECF1" } }, "backColorPrimary": { "solid": { "color": "#1F2630" } }, "fontColorSecondary": { "solid": { "color": "#E8ECF1" } }, "backColorSecondary": { "solid": { "color": "#252D39" } } }],
        "subTotals": [{ "fontColor": { "solid": { "color": "#E8ECF1" } }, "backColor": { "solid": { "color": "#2A3340" } } }],
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#161B22" } }, "gridVertical": true, "gridVerticalColor": { "solid": { "color": "#161B22" } } }]
      }
    }
  }
}
